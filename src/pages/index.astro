---
import Base from '../layouts/Base.astro';
import { levels, stages } from '../data/levels';
import { getLessons } from '../lib/lessons';
import { url } from '../lib/url';

const lessons = await getLessons();
const first = lessons[0];
---
<Base title="OSCP">
  <section class="hero wrap">
    <h1>Học an ninh mạng thực chiến,<br />theo lộ trình OSCP.</h1>
    <p class="hero-sub">
      Nắm chắc bản chất hệ thống trước khi gõ lệnh. Tự tay khai thác qua các bài lab tương tác ngay trong trình duyệt,
      rèn tư duy giải quyết vấn đề độc lập từ số 0 đến làm chủ phòng thi 24 giờ — và bảo vệ doanh nghiệp ngoài đời thực.
    </p>
    <div class="hero-cta">
      <a class="btn primary" id="hero-start" href={url(`bai/${first.id}`)}>Bắt đầu từ bài 0.1</a>
      <a class="btn" href={url('lo-trinh')}>Xem cả lộ trình</a>
    </div>
    <p class="hero-alt">
      Mục tiêu là bảo vệ doanh nghiệp chứ không phải thi OSCP? Đi theo <a href={url('phong-thu')}>nhánh phòng thủ</a>:
      các bài cần cho người làm phòng thủ, xếp từ hiểu tới làm, kết thúc bằng kế hoạch 90 ngày.
    </p>
  </section>

  <section class="wrap what">
    <div class="what-head">
      <span class="st-num">TIÊU CHUẨN THỰC CHIẾN</span>
      <h2>OSCP là kỳ thi như thế nào?</h2>
      <p class="what-lead">
        <strong>OSCP</strong> (Offensive Security Certified Professional) là chứng chỉ kiểm thử xâm nhập thực chiến tiêu chuẩn vàng của ngành an ninh mạng. Không câu hỏi lý thuyết, không trắc nghiệm — thước đo duy nhất là năng lực xâm nhập hệ thống thật dưới áp lực thời gian.
      </p>
    </div>
    <div class="what-grid">
      <div class="what-card">
        <span class="what-icon">⏱️</span>
        <h3>24 giờ thực hành liên tục</h3>
        <p>Đối đầu với một mạng máy tính thực tế hoàn toàn xa lạ: tự dò đường, tìm lỗ hổng, chiếm quyền điều khiển từng máy và hoàn thành báo cáo kỹ thuật trong 24 giờ tiếp theo.</p>
      </div>
      <div class="what-card">
        <span class="what-icon">🧠</span>
        <h3>Tư duy độc lập (Try Harder)</h3>
        <p>Không có đáp án sẵn hay nút bấm tự động. Bạn học cách phân tích phản hồi của hệ thống, đặt giả thuyết logic và kiên trì xoay xở khi bế tắc.</p>
      </div>
      <div class="what-card">
        <span class="what-icon">🛡️</span>
        <h3>Hai mặt của bảo mật</h3>
        <p>Biết cách tấn công là con đường ngắn nhất để hiểu cách phòng thủ. Lộ trình đưa bạn từ góc nhìn của kẻ thâm nhập sang việc bảo vệ hạ tầng doanh nghiệp.</p>
      </div>
    </div>
  </section>

  <section class="wrap how">
    <div>
      <h2>Mỗi bài có gì</h2>
      <ol>
        <li>Một tình huống đời thường và bối cảnh thực tế để hình dung trước khi đụng vào công cụ</li>
        <li>Kiến thức chính và sơ đồ hoặc mô phỏng tương tác chạy ngay trong trình duyệt</li>
        <li>Lệnh thực hành kèm giải nghĩa từng tham số và cách đọc kết quả (trỏ vào để tô sáng trên lệnh)</li>
        <li>Góc phòng thủ: cách quản trị viên và SOC phát hiện, chặn hoặc khắc phục</li>
        <li>Những cái bẫy tâm lý người mới hay mắc khi làm lab và trong phòng thi</li>
        <li>Câu hỏi tự kiểm tra và tóm tắt chiến thuật để mang sang bài sau</li>
      </ol>
    </div>
    <div class="rule">
      <h2>Trước khi học</h2>
      <p>
        Kiến thức ở đây là để bạn hiểu hệ thống bị tấn công ra sao và bảo vệ nó thế nào.
        Chỉ thực hành trong lab của chính bạn hoặc nơi bạn được cho phép bằng văn bản.
        Truy cập trái phép hệ thống của người khác là phạm pháp, kể cả khi "chỉ thử thôi".
      </p>
      <a href={url('quy-tac')}>Đọc quy tắc đầy đủ</a>
    </div>
  </section>

  <section class="wrap">
    <h2>{levels.length} cấp độ, chia ba chặng</h2>
    <p class="stage-note">
      Chín cấp nghe nhiều, nhưng chúng gom thành ba chặng rõ ràng: dựng nền tảng, chinh phục kỳ thi OSCP thực chiến, và mở rộng sang vận hành bảo vệ doanh nghiệp.
    </p>
    {stages.map((st) => (
      <div class="stage">
        <div class="stage-head">
          <span class="st-num">Chặng {st.id}</span>
          <h3>{st.name}</h3>
          <p>{st.intro}</p>
        </div>
        <div class="levels">
          {st.levels.map((id) => {
            const lv = levels.find((x) => x.id === id)!;
            const ls = lessons.filter((l) => l.data.level === lv.id);
            return (
              <a
                class="level-card"
                href={ls.length ? url(`bai/${ls[0].id}`) : url(`lo-trinh#cap-${lv.id}`)}
                title={ls.length ? `Vào bài ${ls[0].data.code}: ${ls[0].data.title}` : undefined}
              >
                <div class="lv-top">
                  <span class="lv-num">Cấp {lv.id}</span>
                  <span class="lv-count">{ls.length} bài</span>
                </div>
                <strong class="lv-name">{lv.name}</strong>
                <p class="lv-blurb">{lv.shortBlurb || lv.blurb}</p>
                {lv.tags && (
                  <div class="lv-tags">
                    {lv.tags.map((t) => (
                      <span class="lv-tag">{t}</span>
                    ))}
                  </div>
                )}
                {ls.length > 0 && <span class="lv-go">Vào bài {ls[0].data.code} →</span>}
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </section>
</Base>

<script is:inline define:vars={{ order: lessons.map((l) => ({ code: l.data.code, title: l.data.title, href: url(`bai/${l.id}`) })) }}>
  // Người đã học dở quay lại trang chủ: đổi nút thành "Học tiếp" ở bài đầu tiên chưa đánh dấu xong.
  (function () {
    let done = [];
    try { done = JSON.parse(localStorage.getItem('oscp-done') || '[]'); } catch (e) {}
    if (!done.length) return;
    const next = order.find((l) => !done.includes(l.code));
    const btn = document.getElementById('hero-start');
    if (!btn || !next) return;
    btn.href = next.href;
    btn.textContent = 'Học tiếp bài ' + next.code + ' · đã xong ' + done.length + '/' + order.length;
    btn.title = next.title;
  })();
</script>

<style>
  .hero { padding-top: 56px; padding-bottom: 24px; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 16px; letter-spacing: -0.01em; line-height: 1.18; }
  .hero-sub { font-size: 1.12rem; color: var(--muted); max-width: 680px; line-height: 1.6; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .hero-cta .btn { padding: 10px 18px; font-size: 1rem; }
  .hero-alt { color: var(--muted); max-width: 640px; margin-top: 18px; font-size: 0.95rem; }

  .what { margin-top: 36px; }
  .what-head { max-width: 760px; margin-bottom: 20px; }
  .what-head h2 { margin: 4px 0 10px; }
  .what-lead { font-size: 1.05rem; color: var(--text); line-height: 1.6; }
  .what-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 16px;
  }
  .what-card {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    display: flex;
    flex-direction: column;
  }
  .what-icon { font-size: 1.5rem; display: block; margin-bottom: 10px; }
  .what-card h3 { font-size: 1.02rem; margin: 0 0 8px; color: var(--text); }
  .what-card p { font-size: 0.88rem; line-height: 1.55; color: var(--muted); margin: 0; }

  .how { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 36px; }
  .how ol { padding-left: 1.3em; line-height: 1.65; font-size: 0.95rem; }
  .rule { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 4px 20px 16px; }

  .stage-note { color: var(--muted); max-width: 720px; font-size: 1rem; }
  .stage { margin-top: 32px; }
  .stage-head { max-width: 720px; margin-bottom: 16px; }
  .stage-head h3 { margin: 2px 0 4px; font-size: 1.25rem; }
  .stage-head p { color: var(--muted); margin: 0; font-size: 0.95rem; line-height: 1.55; }
  .st-num { font-family: var(--mono); font-size: 0.82rem; color: var(--accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }

  .levels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .level-card {
    display: flex;
    flex-direction: column;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .level-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }
  .lv-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .lv-num {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
  }
  .lv-count {
    font-size: 0.78rem;
    color: var(--muted);
    background: var(--surface-2);
    padding: 2px 8px;
    border-radius: 99px;
  }
  .lv-name {
    font-size: 1.08rem;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text);
  }
  .lv-blurb {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0 0 14px;
    flex: 1;
  }
  .lv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }
  .lv-go {
    margin-top: 14px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent);
  }
  .lv-tag {
    font-size: 0.74rem;
    color: var(--muted);
    background: var(--surface-2);
    padding: 2px 7px;
    border-radius: 4px;
    font-family: var(--mono);
  }

  @media (max-width: 860px) {
    .what-grid { grid-template-columns: 1fr; gap: 12px; }
  }
  @media (max-width: 760px) {
    .how { grid-template-columns: 1fr; gap: 16px; }
    .levels { grid-template-columns: 1fr; }
  }
</style>
